---
const initiatives = [
  {
    title: 'Nos outils gratuits',
    description: "Des petits outils d'aide à la décision pour choisir les bonnes automatisations. 100% gratuits, 100% actionnables.",
    image: '/images/insight-ai.jpg',
  },
  {
    title: 'Steroids Academy',
    description: "Apprenez à automatiser et à lancer des projets digitaux vous-même. Pour les entrepreneurs qui veulent garder le contrôle.",
    image: '/images/insight-strategy.jpg',
  },
  {
    title: 'Indépendance technologique européenne',
    description: "On privilégie les outils européens (Infomaniak, Mistral AI, etc.). Pour une tech souveraine.",
    image: '/images/insight-podcast.jpg',
  },
]
---

<section id="about" class="bg-[#0A0E27] px-6 py-20 lg:px-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-14">
      <p class="text-[#D8F847] font-semibold text-sm uppercase tracking-widest mb-4">
        On partage tout
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4 text-balance">
        Parce que la performance, ça doit être accessible à tous
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {initiatives.map((item) => (
        <div class="group rounded-lg overflow-hidden border border-slate-700/40 hover:border-[#CEEF2C]/40 transition-all">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A0E27] to-transparent"></div>
          </div>
          <div class="p-6 -mt-8 relative">
            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-[#D8F847] transition-colors">
              {item.title}
            </h3>
            <p class="text-slate-400 leading-relaxed text-pretty text-sm">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
