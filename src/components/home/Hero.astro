---
---

<section class="relative overflow-hidden bg-[#0A0E27] px-6 py-24 sm:py-32 lg:px-12 min-h-[85vh] flex items-center">
  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src="/images/hero.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0E27] via-[#0A0E27]/90 to-[#0A0E27]/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0E27] via-transparent to-transparent"></div>
  </div>

  <div class="relative max-w-7xl mx-auto w-full">
    <div class="max-w-3xl">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight text-balance">
        <span class="text-[#FF4444]">Votre PME perd de l'argent. Sans le savoir.</span>
      </h1>
      <p class="text-4xl sm:text-5xl lg:text-6xl font-bold text-[#CEEF2C] leading-tight tracking-tight text-balance mt-4">
        Doppez votre PME avec des super-pouvoirs
      </p>
      <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl text-pretty">
        IA, automatisation et produits digitaux pour un ROI immédiat.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/jeu"
          class="bg-[#CEEF2C] text-black font-semibold px-8 py-3.5 rounded hover:shadow-xl hover:shadow-[#CEEF2C]/25 hover:-translate-y-0.5 transition-all"
        >
          <span class="block">🎮 JOUER À AMÉLIORER VOTRE PME</span>
          <span class="block">GRATUITEMENT</span>
        </a>
      </div>
      <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl text-pretty">
        Combien de jours tiendrez-vous sans couler votre boîte ?
      </p>
    </div>
  </div>
</section>
