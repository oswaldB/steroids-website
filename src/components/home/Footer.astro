---
const columns = [
  {
    heading: 'Entreprise',
    links: ['À propos', 'Impact sociétal', 'Indépendance technologique'],
  },
  {
    heading: 'Expertise',
    links: ['Services', 'Insights', 'Techniques secrètes'],
  },
  {
    heading: 'Ressources',
    links: ['Outils gratuits', 'Académie', 'Blog'],
  },
  {
    heading: 'Connecter',
    links: ['Carrières', 'Prendre rendez-vous', 'LinkedIn'],
  },
]
---

<footer class="bg-[#060920] px-6 py-16 lg:px-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-16">
      {columns.map((col) => (
        <div>
          <h4 class="text-sm font-bold text-white uppercase tracking-widest mb-4">
            {col.heading}
          </h4>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                {link === 'Prendre rendez-vous' ? (
                  <a href="/prendre-un-rendez-vous" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">
                    <span class="block">On en parle ?</span>
                    <span class="block">1er projet offert</span>
                  </a>
                ) : link === 'LinkedIn' ? (
                  <a href="https://www.linkedin.com/company/steroids-studio" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Outils gratuits' ? (
                  <a href="/ressources" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Académie' ? (
                  <a href="/academie" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Blog' ? (
                  <a href="/insights" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'À propos' ? (
                  <a href="/about" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Impact sociétal' ? (
                  <a href="/about#societal-impact" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Indépendance technologique' ? (
                  <a href="/about#societal-impact" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Services' ? (
                  <a href="/services" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Insights' ? (
                  <a href="/insights" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : link === 'Techniques secrètes' ? (
                  <a href="/techniques-secretes" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                ) : (
                  <a href="#" class="text-sm text-slate-500 hover:text-[#D8F847] transition-colors">{link}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-800 pt-8">
      <div class="flex items-center gap-3">
        <div class="w-6 h-6 rounded bg-[#CEEF2C] flex items-center justify-center">
          <span class="text-xs font-black text-black leading-none">S</span>
        </div>
        <span class="text-sm text-slate-500">
          Steroids Stratégie & Transformation
        </span>
      </div>
      <p class="text-xs text-slate-600">
        2026 Steroids. Tous droits réservés.
      </p>
    </div>
  </div>
</footer>
