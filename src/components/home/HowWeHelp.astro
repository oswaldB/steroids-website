---
const capabilities = [
  // PILIER 1 : OPTIMISATION DES COÛTS
  {
    number: '01',
    title: 'Automatiser pour économiser',
    description: "On identifie les tâches chronophages et on les automatise. Résultat : moins de salaires, moins d'erreurs, plus de temps pour l'essentiel.",
    concrete: "Exemple : Un client a économisé 93 600€/an en remplaçant 3 postes par des processus automatisés.",
  },
  {
    number: '02',
    title: 'Tableaux de bord qui parlent',
    description: "On vous donne une vue claire sur ce qui rapporte et ce qui coûte. Pour prendre des décisions sans deviner.",
    concrete: "Un client a identifié 40% de missions non rentables en 1 semaine. Et les a supprimées.",
  },
  // PILIER 2 : NOUVELLES ACTIVITÉS STRATÉGIQUES
  {
    number: '03',
    title: 'Nouveaux services digitaux',
    description: "On crée avec vous des offres digitales qui se vendent toutes seules. Pour diversifier vos revenus sans embaucher.",
    concrete: "Un client a lancé un SaaS en 3 mois. 50K€ de CA supplémentaire la 1ère année.",
  },
  {
    number: '04',
    title: 'Clients accrocs à vos outils',
    description: "On conçoit des expériences digitales si simples et efficaces que vos clients ne pourront plus s'en passer.",
    concrete: "Une appli mobile pour un client a boosté son CA de 30% grâce à la fidélisation.",
  },
  // NOUVEAU : RESSOURCES & ACADÉMIE
  {
    number: '05',
    title: 'Outils gratuits & formations',
    description: "Besoin d'agir seul ? On vous donne les outils et les méthodes. Gratuitement.",
    concrete: "Notre bibliothèque d'outils d'aide à la décision et notre Académie pour apprendre à automatiser comme un pro.",
  },
]
---

<section id="capabilities" class="bg-[#0A0E27] px-6 py-20 lg:px-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
        Comment on vous aide à performer
      </h2>
      <p class="text-lg text-slate-400 leading-relaxed text-pretty">
        Deux leviers. Un seul objectif : <span class="text-[#CEEF2C]">faire grandir votre PME</span>.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capabilities.map((cap, i) => (
        <div class={`group bg-slate-800/30 border border-slate-700/40 rounded-lg p-8 hover:border-[#CEEF2C]/40 hover:-translate-y-1 transition-all${i === 4 ? ' md:col-span-2 lg:col-span-1' : ''}`}>
          <span class="text-4xl font-black text-slate-800 group-hover:text-[#CEEF2C]/20 transition-colors select-none leading-none block mb-5">
            {cap.number}
          </span>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-[#D8F847] transition-colors">
            {cap.title}
          </h3>
          <p class="text-slate-400 leading-relaxed text-pretty">
            {cap.description}
          </p>
          {cap.concrete && (
            <div class="mt-4 pt-4 border-t border-slate-700/40">
              <p class="text-sm font-semibold text-white mb-2">Concrètement :</p>
              <p class="text-slate-300 text-sm leading-relaxed text-pretty">
                {cap.concrete}
              </p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
