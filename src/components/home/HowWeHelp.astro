---
const capabilities = [
  {
    number: '01',
    title: 'Automatisation des processus critiques',
    description: "Nous identifions et automatisons vos processus clés pour les rendre totalement indépendants de l'humain. Zéro goulot d'étranglement, zéro dépendance individuelle : vos opérations tournent à plein régime, en permanence.",
    concrete: "Nous aidons Athos Solutions à réduire son nombre d'employés et les frais associés (turnover, arrêts à répétition) en automatisant la remise des livrables sur les plateformes clients et en automatisant les synthèses Excel. En 6 mois, l'entreprise a pu commencer à fermer des postes.",
  },
  {
    number: '02',
    title: "Construction de tableaux de bord et monitoring d'activités",
    description: "Nous construisons des tableaux de bord complets en une semaine chrono. Chaque indicateur clé est analysé pour optimiser la performance opérationnelle et financière.",
    concrete: "Construction de tableaux de bord pour un gros fournisseur de services aux HLM. Résultat : une visibilité claire sur la rentabilité de chaque mission, permettant d'identifier rapidement celles qui sont rentables et celles qui ne le sont pas.",
  },
  {
    number: '03',
    title: 'Nouveaux produits et services en ligne',
    description: "Nous co-construisons avec vous de nouveaux produits et services digitaux. Des opportunités concrètes, des produits qui créent de la désirabilité, bâtis pour croître vite et fort.",
    concrete: "Restructuration complète d'un projet Vyv. Le constat était simple : un projet en déclin malgré des investissements majeurs, car il fallait plus de 3 semaines pour une mise à jour ou un test marketing. Mise en place d'une logique *steroids* avec une obsession pour la vitesse, permettant un développement *live* (changements appliqués en réunion). À la fin de chaque échange, les utilisateurs voyaient les modifications en production.",
  },
  {
    number: '04',
    title: 'Rendre vos clients accro grâce au digital',
    description: "Nous créons des expériences digitales si fluides et addictives que vos clients ne pourront plus s'en passer. Des solutions conçues pour maximiser l'engagement, la rétention et la satisfaction.",
    concrete: "Développement d'une application mobile pour faciliter les prises de commande par les prescripteurs pour une boîte de diagnostic immobilier. Résultat : une augmentation significative du chiffre d'affaires grâce à une fréquence d'utilisation accrue et une fidélisation renforcée des clients.",
  },
]
---

<section id="capabilities" class="bg-[#0A0E27] px-6 py-20 lg:px-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
        Comment nous aidons
      </h2>
      <p class="text-lg text-slate-400 leading-relaxed text-pretty">
        Cinq leviers. Un seul objectif : faire de votre entreprise un leader incontesté.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capabilities.map((cap, i) => (
        <div class={`group bg-slate-800/30 border border-slate-700/40 rounded-lg p-8 hover:border-[#CEEF2C]/40 hover:-translate-y-1 transition-all${i === 4 ? ' md:col-span-2 lg:col-span-1' : ''}`}>
          <span class="text-4xl font-black text-slate-800 group-hover:text-[#CEEF2C]/20 transition-colors select-none leading-none block mb-5">
            {cap.number}
          </span>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-[#D8F847] transition-colors">
            {cap.title}
          </h3>
          <p class="text-slate-400 leading-relaxed text-pretty">
            {cap.description}
          </p>
          {cap.concrete && (
            <div class="mt-4 pt-4 border-t border-slate-700/40">
              <p class="text-sm font-semibold text-white mb-2">Concrètement :</p>
              <p class="text-slate-300 text-sm leading-relaxed text-pretty">
                {cap.concrete}
              </p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
