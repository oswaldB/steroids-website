---
interface Props {
  number: number
  title: string
  description: string
}

const { number, title, description } = Astro.props
---

<div class="p-6 bg-[#CEEF2C]/10 border-l-4 border-[#CEEF2C] rounded">
  <div class="text-4xl font-bold text-[#D8F847] mb-2">{number}</div>
  <h3 class="text-base font-semibold text-white mb-2">{title}</h3>
  <p class="text-sm text-slate-400">{description}</p>
</div>
