---
interface Props {
  tag: string
  title: string
  subtitle: string
  image: string
  readTime: string
  date: string
}

const { tag, title, subtitle, image, readTime, date } = Astro.props
---

<section class="relative min-h-[60vh] flex items-end">
  <img
    src={image}
    alt={title}
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-[#0A0E27] via-[#0A0E27]/80 to-[#0A0E27]/20"></div>
  <div class="relative w-full max-w-4xl mx-auto px-6 pb-12 pt-32 lg:px-0">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#D8F847] transition-colors">Accueil</a>
      <span class="text-slate-600">/</span>
      <a href="/#insights" class="hover:text-[#D8F847] transition-colors">Analyses</a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-500">Article</span>
    </nav>

    <span class="inline-block text-xs font-semibold uppercase tracking-widest text-[#D8F847] mb-4">
      {tag}
    </span>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4 text-balance">
      {title}
    </h1>
    <p class="text-lg text-slate-300 leading-relaxed max-w-2xl text-pretty mb-6">
      {subtitle}
    </p>
    <div class="flex items-center gap-4 text-sm text-slate-500">
      <time>{date}</time>
      <span class="w-1 h-1 rounded-full bg-slate-600"></span>
      <span>{readTime}</span>
    </div>
  </div>
</section>
