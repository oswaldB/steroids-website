---
interface Author {
  name: string
  role: string
  avatar: string
}

interface Props {
  authors: Author[]
}

const { authors } = Astro.props
---

<div class="border border-slate-700/50 rounded-lg p-6 bg-slate-800/20">
  <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">
    Auteurs
  </h3>
  <div class="space-y-4">
    {authors.map((author) => (
      <div class="flex items-center gap-4">
        <div class="relative w-12 h-12 rounded-full overflow-hidden shrink-0">
          <img
            src={author.avatar}
            alt={author.name}
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <p class="text-sm font-semibold text-white">{author.name}</p>
          <p class="text-xs text-slate-500">{author.role}</p>
        </div>
      </div>
    ))}
  </div>
</div>
