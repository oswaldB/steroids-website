---
import Layout from '../layouts/Layout.astro'
import { Navbar } from '../components/home/Navbar'
import Footer from '../components/home/Footer.astro'
---

<Layout
  title="À propos | Steroids"
  description="Doppez votre PME avec des super-pouvoirs. IA, automatisation et produits digitaux pour performer."
>
  <div class="min-h-screen bg-[#0A0E27]">
    <Navbar client:load />

    <!-- Hero Section -->
    <section class="relative py-24 px-6 lg:px-12 border-b border-slate-700/50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center">
          <p class="text-[#D8F847] font-semibold text-sm uppercase tracking-widest mb-4">
            Pourquoi on existe
          </p>
          <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6 tracking-tight text-balance">
            Doppez votre PME avec des super-pouvoirs
          </h1>
          <p class="text-lg text-slate-300 max-w-3xl mx-auto">
            IA, automatisation et produits digitaux pour performer.
            Fonctionner mieux avec le même budget. Aller chercher les gains de productivité.
          </p>
        </div>
      </div>
    </section>

    <!-- NOUVEAU : Section Problèmes -->
    <section class="py-24 px-6 lg:px-12 border-b border-slate-700/50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-14">
          <p class="text-[#D8F847] font-semibold text-sm uppercase tracking-widest mb-4">
            Vous reconnaissez-vous ?
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
            Les 4 problèmes qui tuent votre PME
          </h2>
          <p class="text-slate-300 max-w-2xl mx-auto">
            Et comment on les résout pour de bon.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {[
            {
              icon: "😫",
              title: "Collaborateurs pas assez à jour",
              description: "Vos équipes passent trop de temps sur des tâches répétitives au lieu de créer de la valeur.",
              impact: "Perte de productivité et d'innovation"
            },
            {
              icon: "🔗",
              title: "Trop dépendants des collaborateurs",
              description: "Votre PME dépend d'une ou deux personnes clés. Un absence, et tout s'arrête. Exemple : un collaborateur malade = processus de paiement bloqué.",
              impact: "Risque opérationnel et perte de revenus"
            },
            {
              icon: "💰",
              title: "Besoin de plus de revenus",
              description: "Votre CA stagne alors que vos concurrents grandissent. Vous ratez des opportunités.",
              impact: "Stagnation et perte de parts de marché"
            },
            {
              icon: "📉",
              title: "Besoin de plus de profit",
              description: "Vos marges fondent à cause des coûts cachés et du manque d'efficacité.",
              impact: "Difficultés à investir et grandir"
            }
          ].map((problem) => (
            <div class="bg-slate-800/30 border border-slate-700/40 rounded-lg p-6 hover:border-[#CEEF2C]/40 transition-all">
              <div class="text-4xl mb-4">{problem.icon}</div>
              <h3 class="text-lg font-bold text-white mb-3">{problem.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-3">{problem.description}</p>
              <p class="text-[#D8F847] text-xs font-semibold">→ {problem.impact}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Urgency Section -->
    <section class="py-24 px-6 lg:px-12">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl font-bold text-white mb-6 tracking-tight">
              Pourquoi la vitesse compte
            </h2>
            <p class="text-slate-300 leading-relaxed mb-6">
              Dans une PME, chaque jour sans action, c'est de l'argent qui part en fumée.
              On ne vous fait pas perdre de temps avec des réunions inutiles ou des devis qui traînent.
              <span class="text-[#CEEF2C] font-semibold">On passe à l'action. Tout de suite.</span>
            </p>
            <p class="text-slate-300 leading-relaxed font-semibold">
              La vitesse, c'est la clé pour économiser et grandir.
            </p>
          </div>
          <div class="bg-slate-800/30 border border-slate-700/40 rounded-lg p-8">
            <h3 class="text-xl font-bold text-white mb-4">Notre méthode</h3>
            <ul class="space-y-3 text-slate-300">
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#CEEF2C] flex-shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>On identifie les économies possibles</span>
              </li>
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#CEEF2C] flex-shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>On lance des projets qui rapportent</span>
              </li>
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#CEEF2C] flex-shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>On vous rend autonome</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-24 px-6 lg:px-12 bg-slate-800/30 border-t border-slate-700/50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl font-bold text-white mb-4 tracking-tight">
            Nos piliers
          </h2>
          <p class="text-slate-300 max-w-2xl mx-auto">
            Ce qui guide notre action au quotidien.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-slate-800/30 border border-slate-700/40 rounded-lg p-8 text-center">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#CEEF2C] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Vitesse extrême</h3>
            <p class="text-slate-300 text-sm leading-relaxed">
              Chaque seconde compte. On exécute vite pour que vous voyiez les résultats tout de suite.
            </p>
          </div>
          <div class="bg-slate-800/30 border border-slate-700/40 rounded-lg p-8 text-center">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#CEEF2C] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Économies immédiates</h3>
            <p class="text-slate-300 text-sm leading-relaxed">
              On vous aide à réduire vos coûts dès le premier mois.
            </p>
          </div>
          <div class="bg-slate-800/30 border border-slate-700/40 rounded-lg p-8 text-center">
            <div class="mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#CEEF2C] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Croissance durable</h3>
            <p class="text-slate-300 text-sm leading-relaxed">
              On vous aide à grandir sans dépendre de nous.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section class="py-24 px-6 lg:px-12 border-t border-slate-700/50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-14">
          <p class="text-[#D8F847] font-semibold text-sm uppercase tracking-widest mb-4">
            Résultats concrets
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
            Ce qu'on a fait pour nos clients
          </h2>
          <p class="text-slate-300 max-w-2xl mx-auto">
            Des économies réelles. Des croissances mesurables.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {[
            {
              title: "93 600€ d'économies par an",
              description: "En remplaçant 3 postes par des processus automatisés. ROI en moins de 6 mois.",
              client: "Entreprise de services",
              icon: "💰"
            },
            {
              title: "50K€ de CA supplémentaire",
              description: "Avec le lancement d'un SaaS en 3 mois. Sans embauche.",
              client: "Startup tech",
              icon: "📈"
            },
            {
              title: "+30% de chiffre d'affaires",
              description: "Grâce à une appli mobile qui a fidélisé les clients.",
              client: "Diagnostic immobilier",
              icon: "📱"
            },
            {
              title: "40% de missions non rentables identifiées",
              description: "Et supprimées en 1 semaine grâce à nos tableaux de bord.",
              client: "Fournisseur HLM",
              icon: "📊"
            },
            {
              title: "Projet livré en 2 semaines",
              description: "Au lieu de 3 mois ailleurs. Avec des itérations illimitées.",
              client: "PME industrielle",
              icon: "⚡"
            },
            {
              title: "10h gagnées par semaine",
              description: "Grâce à l'automatisation des tâches administratives.",
              client: "Boulangerie",
              icon: "⏰"
            }
          ].map((result) => (
            <div class="bg-slate-800/30 border border-slate-700/40 rounded-lg p-8 hover:border-[#CEEF2C]/40 transition-all">
              <div class="text-4xl mb-4">{result.icon}</div>
              <h3 class="text-xl font-bold text-white mb-3">{result.title}</h3>
              <p class="text-slate-400 leading-relaxed mb-4">{result.description}</p>
              <p class="text-sm text-slate-500">Client : {result.client}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 px-6 lg:px-12 bg-slate-800/30 border-t border-slate-700/50">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-white mb-6">Prêt à dopez votre PME ?</h2>
        <p class="text-slate-300 text-lg mb-8">
          On vous aide à fonctionner mieux avec le même budget 
          et à aller chercher les gains de productivité.
          Premier atelier découverte : 3 000€ offerts.
        </p>
        <a
          href="/prendre-un-rendez-vous"
          class="inline-flex bg-[#CEEF2C] text-black font-semibold px-8 py-3.5 rounded hover:shadow-xl hover:shadow-[#CEEF2C]/25 hover:-translate-y-0.5 transition-all"
        >
          On en parle ?
        </a>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
