---// src/pages/techniques-secretes.astro
import Layout from '../layouts/Layout.astro';
import { WaveBackground } from '../components/WaveBackground';
import { Navbar } from '../components/home/Navbar';
import Footer from '../components/home/Footer.astro';

const title = "Nos techniques secrètes | Steroids";
const description = "Découvrez les techniques secrètes que nous utilisons pour transformer les entreprises et maximiser leur rentabilité.";
---

<Layout title={title} description={description}>
  <div class="relative min-h-screen bg-[#0A0E27]">
    <WaveBackground client:load />
    <div class="relative z-10">
      <Navbar client:load />
      <main class="px-6 py-20 lg:px-12">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 text-center">
            Nos techniques secrètes
          </h1>
          <p class="text-lg text-slate-300 mb-12 text-center max-w-3xl mx-auto">
            Découvrez les méthodes uniques que nous utilisons pour transformer les entreprises, maximiser leur rentabilité et accélérer leur croissance.
          </p>

          <!-- Techniques Section -->
          <div class="space-y-12">
            <!-- Technique 1: Chemin de crête -->
            <section class="bg-slate-800/30 border border-slate-700 rounded-lg p-8">
              <h2 class="text-2xl font-bold text-white mb-4">
                La technique du chemin de crête
              </h2>
              <p class="text-slate-300 mb-4">
                <span class="font-semibold text-[#D8F847]">Ou comment toujours rester rentable tout en se transformant.</span>
              </p>
              <div class="space-y-4 text-slate-300">
                <p>
                  Cette technique consiste à identifier et suivre le "chemin de crête" de votre entreprise : la trajectoire optimale qui maximise la rentabilité tout en permettant une transformation continue. En restant sur ce chemin, vous évitez les pièges des coûts excessifs et des risques inutiles, tout en progressant vers vos objectifs stratégiques.
                </p>
                <p>
                  <span class="font-semibold">Application :</span> Nous analysons vos flux de revenus, vos coûts et vos opportunités pour tracer ce chemin. Chaque décision est évaluée en fonction de son impact sur la rentabilité immédiate et future.
                </p>
              </div>
            </section>

            <!-- Technique 2: Petites bouchées -->
            <section class="bg-slate-800/30 border border-slate-700 rounded-lg p-8">
              <h2 class="text-2xl font-bold text-white mb-4">
                La technique des petites bouchées
              </h2>
              <p class="text-slate-300 mb-4">
                <span class="font-semibold text-[#D8F847]">Ou comment utiliser l'IA là où elle excelle : ce qui est petit.</span>
              </p>
              <div class="space-y-4 text-slate-300">
                <p>
                  L'IA est souvent perçue comme une solution magique pour tout, mais son vrai pouvoir réside dans sa capacité à traiter des tâches petites et répétitives avec une précision et une vitesse inégalées. Cette technique consiste à identifier ces "petites bouchées" dans vos processus et à les automatiser avec l'IA.
                </p>
                <p>
                  <span class="font-semibold">Application :</span> Nous identifions les micro-tâches dans vos opérations (saisie de données, analyse de documents, réponse aux FAQ, etc.) et les automatisons avec des outils d'IA spécialisés. Cela libère vos équipes pour se concentrer sur des tâches à plus forte valeur ajoutée.
                </p>
              </div>
            </section>
          </div>

          <!-- Call to Action -->
          <div class="mt-16 text-center">
            <p class="text-slate-300 mb-6">
              Ces techniques ne sont que la partie émergée de l'iceberg. 
              <a href="/prendre-un-rendez-vous" class="text-[#D8F847] font-semibold hover:underline">
                Découvrons votre premier projet gratuitement
              </a> 
              pour voir comment nous pouvons les appliquer à votre entreprise.
            </p>
          </div>
        </div>
      </main>
      <Footer />
    </div>
  </div>
</Layout>