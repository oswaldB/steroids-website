---
import Layout from '../layouts/Layout.astro'
import { WaveBackground } from '../components/WaveBackground'
import { Navbar } from '../components/home/Navbar'
import Hero from '../components/home/Hero.astro'
import ProblemsSection from '../components/home/ProblemsSection.astro'
import WhySpeedMatters from '../components/home/WhySpeedMatters.astro'
import ToolsSection from '../components/home/ToolsSection.astro'
import TestimonialsSection from '../components/home/TestimonialsSection.astro'
import FinalCTA from '../components/home/FinalCTA.astro'
import Footer from '../components/home/Footer.astro'
---

<Layout>
  <div class="relative min-h-screen bg-[#0A0E27]">
    <WaveBackground client:load />
    <div class="relative z-10">
      <Navbar client:load />
      <Hero />
      <ProblemsSection />
      <WhySpeedMatters />
      <ToolsSection />
      <TestimonialsSection />
      <FinalCTA />
      <Footer />
    </div>
  </div>
</Layout>
